<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ThaiWrap.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/ThaiWrap/ThaiWrap.csproj" />
    <ProjectReference Include="../../src/ThaiWrap.Formats/ThaiWrap.Formats.csproj" />
    <!-- ThaiTextFilter อยู่ในโปรเจกต์ plugin (net35) — link เป็น source มาทดสอบแบบไม่ผูก BepInEx -->
    <Compile Include="../../src/ThaiWrap.BepInEx/ThaiTextFilter.cs" Link="BepInEx/ThaiTextFilter.cs" />
  </ItemGroup>

  <!-- เทสเป็น console runner ไม่ใช่ xunit — `dotnet test` จะจบ exit 0 โดยไม่รันอะไรเลย
       จึงบังคับให้ fail พร้อมบอกคำสั่งที่ถูกแทนการผ่านเงียบ -->
  <Target Name="RejectDotnetTest" BeforeTargets="VSTest">
    <Error Text="โปรเจกต์นี้เป็น console runner — dotnet test ไม่รันเทส ให้ใช้: dotnet run --project tests/ThaiWrap.Tests -- data/words_th.txt" />
  </Target>

</Project>
