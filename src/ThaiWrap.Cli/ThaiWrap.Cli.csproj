<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ThaiWrap.Cli</RootNamespace>
    <!-- สำหรับ dotnet publish -r <RID>: single-file trim — ใส่ในนี้เพื่อไม่ให้ property
         ไหลไปเป็น global กดโปรเจกต์ netstandard2.0 (NETSDK1124) -->
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../ThaiWrap/ThaiWrap.csproj" />
    <ProjectReference Include="../ThaiWrap.Formats/ThaiWrap.Formats.csproj" />
  </ItemGroup>

</Project>
