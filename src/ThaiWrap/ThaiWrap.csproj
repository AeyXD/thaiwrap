<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>ThaiWrap</RootNamespace>
    <!-- trimming ทำที่ระดับแอป (CLI) — ไลบรารี netstandard ปิดไม่ให้ NETSDK1124 -->
    <PublishTrimmed>false</PublishTrimmed>
    <Description>Thai word segmentation + ZWSP insertion for game text line-breaking</Description>
  </PropertyGroup>

</Project>
